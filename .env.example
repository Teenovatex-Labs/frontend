# Backend API base URL (the backend runs on port 4000 locally)
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Google Sign-In client id (same value as the backend GOOGLE_CLIENT_ID)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Browser error alerts (optional): the DSN of your Sentry browser project. Nothing personal is sent.
# NEXT_PUBLIC_SENTRY_DSN=
